APP_NAME=KrishiChakra API
DATABASE_URL=sqlite:///./krishichakra.db
API_PREFIX=/api
CORS_ORIGINS=*

# Official government market-data resource.
# Do NOT invent this URL. Put the verified data.gov.in/AGMARKNET machine-readable endpoint here.
GOV_PRICE_API_URL=
GOV_PRICE_API_KEY=
GOV_PRICE_API_KEY_HEADER=api-key
GOV_PRICE_AUTH_MODE=header
GOV_PRICE_SOURCE_NAME=Government Market Data
GOV_PRICE_HTTP_METHOD=GET
GOV_PRICE_REQUEST_PARAMS_JSON={}
# Example JSONPath-like dot path to records, e.g. records or result.records.
GOV_PRICE_RECORDS_PATH=records

PRICE_SYNC_HOUR=6
PRICE_SYNC_MINUTE=30
PRICE_SYNC_TIMEZONE=Asia/Kolkata
